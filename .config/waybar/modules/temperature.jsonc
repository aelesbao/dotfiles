{
    "group/temperature": {
        "orientation": "inherit",
        "drawer": {
            "children-class": "not-first",
            "transition-duration": 200,
            "transition-left-to-right": false
        },
        "modules": [
            "temperature#cpu_package",
            "temperature#nvme",
            "temperature#cpu"
        ]
    },
    // CPU temperature
    "temperature#cpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}°C",
        "format-critical": "󱩅  {temperatureC}°C",
        "format-icons": [
            "",
            "",
            ""
        ],
        "tooltip-format": "CPU {temperatureC}°C",
        "on-click": "psensor"
    },
    // CPU Package temperature
    "temperature#cpu_package": {
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp2_input",
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}°C",
        "format-critical": "󱩅  {temperatureC}°C",
        "format-icons": [
            "",
            "",
            ""
        ],
        "tooltip-format": "CPU Package {temperatureC}°C",
        "on-click": "psensor"
    },
    // NVMe temperature
    "temperature#nvme": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format": "{icon} 󰋊 {temperatureC}°C",
        "format-critical": "󱩅 󰋊 {temperatureC}°C",
        "format-icons": [
            "",
            "",
            ""
        ],
        "tooltip-format": "NVMe {temperatureC}°C",
        "on-click": "psensor"
    }
}
