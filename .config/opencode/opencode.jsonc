{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "openai/gpt-5.5",
  "small_model": "opencode/minimax-m2.5-free",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm *": "ask",
      "ls *": "allow",
      "find *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "rg *": "allow",
      "cargo *": "allow",
      "cargo publish *": "deny",
      "sui move *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "test *": "allow",
      "npm run lint": "allow",
      "npm run test*": "allow",
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "ask",
    "external_directory": "deny",
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT OSS 20B",
        },
      }
    }
  },
  "disabled_providers": [
    "anthropic",
    "grok",
    "google",
  ],
  "formatter": {
    "rustfmt": {
      "command": [
        "cargo",
        "+nightly",
        "fmt",
        "--",
        "$FILE",
      ],
      "extensions": [
        "rs",
      ]
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "target/**",
      ".git/**"
    ]
  },
}
