{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "openai/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "opencode/minimax-m2.5-free",
    },
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo publish *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sui move *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "test *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run lint",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run test*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
  ],
  "providers": {
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT OSS 20B",
        },
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "anthropic",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "grok",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "google",
        "effect": "deny"
      },
    ],
  },
  "formatter": {
    "rustfmt": {
      "command": [
        "cargo",
        "+nightly",
        "fmt",
        "--",
        "$FILE",
      ],
      "extensions": [
        "rs",
      ]
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "target/**",
      ".git/**"
    ]
  },
}
