{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "autoupdate": false,
  "share": "disabled",
  "model": "openai/gpt-5.3-codex",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "cargo *": "allow",
      "rm *": "ask",
      "ls *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "cat *": "allow",
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "ask",
    "external_directory": "deny",
  },
  "keybinds": {},
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT OSS 20B",
        },
        "qwen/qwen3-30b-a3b-2507": {
          "name": "Qwen3 30B",
        },
        "qwen/qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B",
        },
        "deepseek/deepseek-r1-0528-qwen3-8b": {
          "name": "Distilled DeepSeek R1 0528 (Qwen3 8B post-training)",
        },
      }
    }
  },
  "disabled_providers": [
    "anthropic",
    "grok",
    "google",
  ],
  "formatter": {
    "rustfmt": {
      "command": [
        "cargo",
        "+nightly",
        "fmt",
        "--",
        "$FILE",
      ],
      "extensions": [
        "rs",
      ]
    }
  },
}
