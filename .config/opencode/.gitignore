# This file contains the local service password.
/service.json

# Keep local secrets out of Git.
.env
.env.*
!.env.example
!.env.*.example

# Ignore backups and temporary files.
/backups/
*.bak
*.bak.*
*.log
*.tmp
*.swp
*.swo
*~
