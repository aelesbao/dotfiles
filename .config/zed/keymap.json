// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "alt-[": "pane::ActivatePreviousItem",
      "alt-]": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "space space": "file_finder::Toggle",
      "super-s": "workspace::Save",
      "super-w": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "super-v": "editor::Paste"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      ";": "command_palette::Toggle"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      ";": "vim::VisualCommand",
      "shift-s": "vim::PushAddSurrounds"
    }
  },
  {
    "context": "vim_mode == replace || vim_mode == insert",
    "bindings": {
      "alt-l": "workspace::ActivatePaneRight",
      "alt-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "alt-l": "workspace::ActivatePaneRight",
      "alt-h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(Editor && edit_prediction)",
    "bindings": {
      "ctrl-y": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "(Editor && edit_prediction_conflict)",
    "bindings": {
      "ctrl-y": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "GitCommit > Editor",
    "bindings": {
      "ctrl-y": "git::GenerateCommitMessage"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "ctrl-y": "git::GenerateCommitMessage"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "super-c": "terminal::Copy",
      "super-v": "terminal::Paste"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "super-c": "project_panel::CollapseAllEntries",
      "super-v": "project_panel::Paste"
    }
  }
]
