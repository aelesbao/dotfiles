[submodule ".zprezto"]
	path = .zprezto
	url = https://github.com/aelesbao/prezto
	branch = custom
	update = rebase
[submodule ".config/nvim"]
	path = .config/nvim
	url = https://github.com/aelesbao/nvim.git
	branch = main
	update = rebase
[submodule "folke/tokyonight.nvim"]
	path = .local/src/tokyonight.nvim
	url = https://github.com/folke/tokyonight.nvim
[submodule "catppuccin/k9s"]
	path = .local/src/catppuccin/k9s
	url = https://github.com/catppuccin/k9s
[submodule "alacritty/themes"]
	path = .config/alacritty/themes
	url = https://github.com/alacritty/alacritty-theme
[submodule "rebelot/kanagawa.nvim"]
	path = .local/src/kanagawa.nvim
	url = https://github.com/rebelot/kanagawa.nvim
